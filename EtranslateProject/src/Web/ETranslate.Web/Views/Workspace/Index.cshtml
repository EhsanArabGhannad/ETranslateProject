@model WorkspaceView
@{ ViewData["Title"] = UiText.Get("CalismaAlani"); }
<div class="page-heading"><div><span class="eyebrow">@UiText.Get("CALISMAALANINIZ")</span><h1>@(Model.Tenant?.Name ?? UiText.Get("HosGeldiniz"))</h1><p class="muted">@UiText.Get("CeviriHazirligiTaslakPDFVeIcInceleme")</p></div><span class="badge">@UiText.Get("HazirlikVeIncelemeImzasiz")</span></div>
@if (Model.Tenants.Count > 0) {
    <nav class="tenant-tabs" aria-label="@UiText.Get("CalismaAlanlari")">@foreach (var tenant in Model.Tenants) { <a class="@(tenant.Id == Model.Tenant?.Id ? "selected" : "")" asp-action="Index" asp-route-tenantId="@tenant.Id" asp-route-assignedToMe="@Model.AssignedToMe">@tenant.Name</a> }</nav>
}
@if (Model.Tenant is not null) { <partial name="_SubscriptionWriteNotice" model="new SubscriptionWriteNotice(Model.Tenant.Id, Model.WriteStatus)" /> }
<div class="workspace-grid">
<section class="card">
    <div class="section-heading"><h2>@(Model.AssignedToMe ? UiText.Get("BanaAtananIsler") : UiText.Get("CeviriDosyalari"))</h2><span class="badge">@Model.Jobs.Count dosya</span></div>
    @if (Model.Tenant is not null) { <nav class="tenant-tabs" aria-label="@UiText.Get("DosyaFiltreleri")"><a class="@(!Model.AssignedToMe ? "selected" : "")" asp-action="Index" asp-route-tenantId="@Model.Tenant.Id">@UiText.Get("TumDosyalar")</a><a class="@(Model.AssignedToMe ? "selected" : "")" asp-action="Index" asp-route-tenantId="@Model.Tenant.Id" asp-route-assignedToMe="true">@UiText.Get("Islerim")</a></nav><p class="muted">@UiText.Get("AtamaIsDuzeniIcindirDigerYetkiliUyelerin")</p> }
    @if (Model.Tenant is null) { <div class="empty"><h3>@UiText.Get("OnceCalismaAlaniniziOlusturun")</h3><p>@UiText.Get("BagimsizCevirmenVeyaTercumeBurosuDosyalarVe")</p></div> }
    else {
        @if (Model.Jobs.Count == 0) { <div class="empty"><h3>@(Model.AssignedToMe ? UiText.Get("HenuzSizeAtanmisBirIsYok") : UiText.Get("HenuzDosyanizYok"))</h3><p>@(Model.AssignedToMe ? UiText.Get("YoneticidenDosyaninSorumluCevirmeniniAtamasiniIsteyin") : UiText.Get("YandakiFormdanIlkCeviriniziBaslatin"))</p></div> }
        @foreach (var job in Model.Jobs) { <a class="job-row" asp-action="Editor" asp-route-tenantId="@Model.Tenant.Id" asp-route-jobId="@job.Id"><div><h3 dir="auto">@job.Title</h3><span class="muted" dir="ltr">@job.SourceLanguageCode → @job.TargetLanguageCode</span><p class="muted">@(job.AssignedTranslatorUserId.HasValue ? UiText.Get("SorumluCevirmenAtandi") : UiText.Get("CevirmenAtanmadi"))</p></div><span class="badge">@(job.NotaryRequirement == "Required" ? UiText.Get("NoterGerekli") : UiText.Get("NoterGerekmiyor"))</span><span>@UiText.Get("Ac")</span></a> }
        <p class="muted">@UiText.Get("EnSon100DosyaGosterilir")</p>
    }
</section>
<aside class="card"><fieldset class="subscription-lock" disabled="@(!Model.CanWrite)">
@if (Model.Tenant is not null) {
    <h2>@UiText.Get("YeniDosya")</h2><form asp-action="CreateJob" method="post"><input type="hidden" name="tenantId" value="@Model.Tenant.Id" />
        <label for="title">@UiText.Get("DosyaBasligi")</label><input id="title" name="title" maxlength="200" required placeholder="@UiText.Get("OrnDiplomaCevirisi")" dir="auto" />
        <div class="two-fields"><div><label for="source">@UiText.Get("KaynakDil")</label><input id="source" name="sourceLanguageCode" value="fa" maxlength="10" dir="ltr" required /></div><div><label for="target">@UiText.Get("HedefDil")</label><input id="target" name="targetLanguageCode" value="tr" maxlength="10" dir="ltr" required /></div></div>
        <label for="notary">@UiText.Get("NoterGereksinimi")</label><select id="notary" name="notaryRequirement"><option value="NotRequired">@UiText.Get("GerekliDegil")</option><option value="Required">@UiText.Get("Gerekli")</option></select>
        <div id="notary-options" hidden><label for="notary-mode">@UiText.Get("NoterIslemYontemi")</label><select id="notary-mode" name="notaryProcessingMode"><option value="Physical">@UiText.Get("YazdirmaVeFizikiOnay")</option><option value="Hybrid">@UiText.Get("Hibrit")</option><option value="Digital">@UiText.Get("DijitalIleridePlanlaniyor")</option></select><p class="muted">@UiText.Get("BuSecimYalnizcaDosyaGereksiniminiKaydederNoter")</p></div>
        <label for="acceptance">@UiText.Get("IbrazEdilecekKurumIstegeBagli")</label><select id="acceptance" name="acceptanceProfile"><option value="">@UiText.Get("OzelKosulYok")</option><option value="General">@UiText.Get("Genel")</option><option value="Embassy">@UiText.Get("Buyukelcilik")</option><option value="Consulate">@UiText.Get("Konsolosluk")</option><option value="VisaApplicationCenter">@UiText.Get("VizeBasvuruMerkezi")</option><option value="GovernmentAuthority">@UiText.Get("KamuKurumu")</option><option value="EducationalInstitution">@UiText.Get("EgitimKurumu")</option><option value="Bank">@UiText.Get("Banka")</option><option value="Other">@UiText.Get("Diger")</option></select>
        <div id="other-options" hidden><label for="other">@UiText.Get("DigerAciklamasi")</label><input id="other" name="acceptanceProfileOther" maxlength="200" dir="auto" /></div><button type="submit">@UiText.Get("DosyaOlustur")</button>
    </form>
} else { <h2>@UiText.Get("SizeOzelCalismaAlani")</h2><p class="muted">@UiText.Get("HerAlaninUyeleriDosyalariVeSablonlariAyridir")</p> }
</fieldset></aside>
</div>
<details class="card" open="@(Model.Tenant is null)"><summary>@UiText.Get("YeniCalismaAlaniOlustur")</summary><form asp-action="CreateTenant" method="post" class="tenant-form"><div><label for="tenant-name">@UiText.Get("CalismaAlaniAdi")</label><input id="tenant-name" name="name" maxlength="200" required dir="auto" /></div><div><label for="slug">@UiText.Get("BenzersizLatinHarfliKimlik")</label><input id="slug" name="slug" dir="ltr" pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="100" required placeholder="my-office" /></div><div><label for="type">@UiText.Get("FaaliyetTuru")</label><select id="type" name="type"><option value="IndependentTranslator">@UiText.Get("BagimsizCevirmen")</option><option value="TranslationOffice">@UiText.Get("TercumeBurosu")</option></select></div><button type="submit">@UiText.Get("CalismaAlaniOlustur")</button></form><p class="muted">@UiText.Get("30GunlukDenemeCevrimIciOdemeHenuz")</p></details>
