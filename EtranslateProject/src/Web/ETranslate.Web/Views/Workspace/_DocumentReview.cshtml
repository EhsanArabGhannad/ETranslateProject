@model EditorView
@if (Model.Review is { } state) {
    var latest = state.Reviews.FirstOrDefault();
    var pdfs = Model.PdfVersions.Where(pdf => pdf.RevisionNumber == Model.ViewedRevision).ToList();
    var needsNewRevision = latest is not null && (latest.Status is "ChangesRequested" or "Reopened") && Model.ViewedRevision <= latest.RevisionNumber;
    <section class="draft-pdf-section review-section"><h3>@UiText.Get("IncelemeVeIcOnay")</h3>
    <p class="muted">@UiText.Get("BuOnayImzaCevirmenYeminiVeyaNoter")</p>
    <p><span class="badge">@ReviewStateView.Label(state.Status)</span> · İnceleme turu @state.Round</p>
    @if (Model.CanWrite && !Model.Historical && !Model.Conflict && state.CanManage && !state.Locked && needsNewRevision) {
        <p class="notice">@UiText.Get("IadeVeyaYenidenAcmaSonrasindaDuzeltmeleriYeni")</p>
    }
    @if (Model.CanWrite && !Model.Historical && !Model.Conflict && state.CanManage && !state.Locked && !needsNewRevision && Model.ViewedRevision > 0) {
            <form asp-action="SubmitReview" method="post" class="review-form">
                <input type="hidden" name="tenantId" value="@Model.TenantId" /><input type="hidden" name="jobId" value="@Model.Job.Id" />
                <input type="hidden" name="expectedRevision" value="@Model.ViewedRevision" /><input type="hidden" name="expectedRound" value="@state.Round" />
                <label for="review-pdf">@UiText.Get("IncelenecekKayitliSurumunPDFDosyasi")</label><select id="review-pdf" name="pdfVersionId" data-revision="@Model.ViewedRevision" required>
                @foreach (var pdf in pdfs) { <option value="@pdf.Id">Sürüm @pdf.RevisionNumber · @pdf.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</option> }
                </select><button id="review-submit" class="secondary" type="submit" disabled="@(pdfs.Count == 0)">Sürümü gönder: @Model.ViewedRevision inceleme için</button>
            </form>
        if (pdfs.Count == 0) { <p id="review-pdf-needed" class="notice">@UiText.Get("IncelemeyeGondermeyiEtkinlestirmekIcinOnceKayitliSurumun")</p> }
    }
    @if (Model.CanWrite && !Model.Historical && !Model.Conflict && latest is not null) {
        var actions = new List<(string Action, string Label)>();
        if (state.Status == "AwaitingReview") {
            if (state.CanReview) { actions.Add(("Approve", UiText.Get("BuSurumuIcOnaydanGecir"))); actions.Add(("RequestChanges", UiText.Get("DuzeltmeIste"))); }
            if (state.CanReview || state.CanManage && state.UserId == latest.SubmittedByUserId) { actions.Add(("Withdraw", UiText.Get("GonderimiGeriCek"))); }
        } else if (state.Status == "Approved" && state.CanReview) { actions.Add(("Reopen", UiText.Get("DuzeltmeIcinYenidenAc"))); }
        foreach (var action in actions) {
            <form asp-action="DecideReview" method="post" class="review-form">
                <input type="hidden" name="tenantId" value="@Model.TenantId" /><input type="hidden" name="jobId" value="@Model.Job.Id" />
                <input type="hidden" name="reviewId" value="@latest.Id" /><input type="hidden" name="reviewAction" value="@action.Action" />
                <label for="note-@action.Action">@(action.Action == "Approve" ? UiText.Get("OnayNotuIstegeBagli") : UiText.Get("GerekceZorunlu"))</label>
                <textarea id="note-@action.Action" name="note" rows="2" maxlength="2000" required="@(action.Action != "Approve")" dir="auto"></textarea>
                <button type="submit" class="secondary">@action.Label</button>
            </form>
        }
    }
    <p id="review-status" role="status" class="muted">@UiText.Get("HerIslemdenOnceMetinDegisiklikleriniKaydedinJavaScript")</p>
    <details><summary>İnceleme geçmişi (@state.Reviews.Count)</summary>
    @foreach (var review in state.Reviews) {
        <article class="review-history"><h4>Tur @review.Round · Sürüm @review.RevisionNumber · @ReviewStateView.Label(review.Status)</h4>
            <a asp-action="DraftPdf" asp-route-tenantId="@Model.TenantId" asp-route-jobId="@Model.Job.Id" asp-route-pdfId="@review.PdfVersionId">@UiText.Get("BuIncelemeninPDFDosyasiniIndir")</a> ·
            <a asp-action="Editor" asp-route-tenantId="@Model.TenantId" asp-route-jobId="@Model.Job.Id" asp-route-revisionNumber="@review.RevisionNumber" target="_blank" rel="noopener">@UiText.Get("CeviriSurumunuGoruntule")</a>
            <small dir="ltr">SHA-256: @review.PdfSha256</small>
            <p class="muted">@UiText.Get("Gonderim") <span dir="ltr">@review.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC · @review.SubmittedByUserId</span></p>
            @if (review.DecidedAtUtc is not null) { <p>@UiText.Get("Karar") <span dir="ltr">@review.DecidedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC · @review.DecidedByUserId</span> · @review.DecisionNote</p> }
            @if (review.ReopenedAtUtc is not null) { <p>@UiText.Get("YenidenAcma") <span dir="ltr">@review.ReopenedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC · @review.ReopenedByUserId</span> · @review.ReopenNote</p> }
            <details><summary>Gönderim anındaki kaynak belgeler (@review.SourceFiles.Count)</summary>
            @foreach (var source in review.SourceFiles) {
                <div><a asp-action="Source" asp-route-tenantId="@Model.TenantId" asp-route-jobId="@Model.Job.Id" asp-route-sourceFileId="@source.Id" asp-route-download="true">@source.OriginalFileName</a><small dir="ltr">SHA-256: @source.Sha256</small></div>
            }
            </details>
        </article>
    }
    </details></section>
}
