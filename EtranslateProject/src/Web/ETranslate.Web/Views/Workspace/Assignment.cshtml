@model AssignmentPageView
@{ ViewData["Title"] = UiText.Get("CevirmenAtamasi"); var assignment = Model.Assignment; }
<a class="back-link" asp-action="Index" asp-route-tenantId="@Model.TenantId">@UiText.Get("CalismaAlaninaDon2")</a>
<div class="page-heading"><div><span class="eyebrow">@UiText.Get("ISATAMASI")</span><h1>@UiText.Get("DosyaninSorumluCevirmeni")</h1><p>@Model.Job.Title</p></div><span class="badge">Atama sürümü @assignment.AssignmentVersion</span></div>
<section class="card assignment-card"><h2>@UiText.Get("MevcutAtama")</h2><p dir="auto">@Model.MemberLabel(assignment.AssignedTranslatorUserId)</p>
@if (assignment.AssignedTranslatorUserId.HasValue && assignment.CanManage && !Model.Candidates.Any(item => item.UserId == assignment.AssignedTranslatorUserId)) { <p class="notice">@UiText.Get("MevcutUyeYazmaYetkiliEtkinUyelerArasinda")</p> }
@if (assignment.ChangedAtUtc.HasValue) { <p class="muted" dir="ltr">@assignment.ChangedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC · Actor: @assignment.ChangedByUserId</p> }
<p class="muted">@UiText.Get("AtamaYalnizcaIsSorumlusunuBelirlerDigerYetkili")</p>
<partial name="_SubscriptionWriteNotice" model="new SubscriptionWriteNotice(Model.TenantId, Model.WriteStatus)" />
@if (assignment.CanManage && Model.CanWrite) {
    <form asp-action="AssignTranslator" method="post"><input type="hidden" name="tenantId" value="@Model.TenantId" /><input type="hidden" name="jobId" value="@Model.Job.Id" /><input type="hidden" name="expectedAssignmentVersion" value="@assignment.AssignmentVersion" />
        <label for="assigned-translator">@UiText.Get("SorumluCevirmen")</label><select id="assigned-translator" name="translatorUserId"><option value="" selected="@(!assignment.AssignedTranslatorUserId.HasValue)">@UiText.Get("AtamaYokAtamayiKaldir")</option>
        @if (assignment.AssignedTranslatorUserId.HasValue && !Model.Candidates.Any(item => item.UserId == assignment.AssignedTranslatorUserId)) { <option value="@assignment.AssignedTranslatorUserId" selected>@UiText.Get("MevcutUyeIzinVerilenSeceneklerdeDegilYeni")</option> }
        @foreach (var member in Model.Candidates) { <option value="@member.UserId" selected="@(member.UserId == assignment.AssignedTranslatorUserId)">@member.Email · @TeamPageView.RoleLabel(member.Role)</option> }</select>
        <label for="assignment-note">@UiText.Get("DegisiklikAciklamasiIstegeBagli")</label><textarea id="assignment-note" name="note" maxlength="500" rows="2" dir="auto"></textarea><button type="submit">@UiText.Get("CevirmenAtamasiniKaydet")</button>
    </form><p class="muted">@UiText.Get("EnFazla200EtkinUyeGosterilirDegisiklikten")</p>
} else if (!assignment.CanManage) { <p class="notice">@UiText.Get("DosyaSorumlusunuYalnizcaAlanSahibiVeyaYonetici")</p> }
</section>
<section class="card"><h2>@UiText.Get("AtamaGecmisiSon50Degisiklik")</h2>
@if (assignment.History.Count == 0) { <p class="muted">@UiText.Get("HenuzAtamaKaydedilmedi")</p> }
@foreach (var change in assignment.History) { <article class="team-member"><h3>Değişiklik @change.Version</h3><p dir="auto">@Model.MemberLabel(change.PreviousTranslatorUserId) → @Model.MemberLabel(change.TranslatorUserId)</p><p>@change.Note</p><small dir="ltr">@change.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm") UTC · Actor: @change.ActorUserId</small></article> }
</section>
