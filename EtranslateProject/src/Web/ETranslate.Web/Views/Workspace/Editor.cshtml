@model EditorView
@{ ViewData["Title"] = Model.Job.Title; var plain = Model.ContentIsSupported ? DocumentText.TryPlainText(Model.EditorContentJson) : null; var editable = Model.ContentIsSupported && Model.CanWrite && !Model.Historical && !Model.Conflict && Model.Review is { Locked: false, CanManage: true };
   var compatible = Model.ContentIsSupported && Model.ContentDescriptor.TryRead(Model.EditorContentJson, out _);
   var sources = Model.Document?.SourceFiles ?? Array.Empty<SourceFileView>(); }
<a class="back-link" asp-action="Index" asp-route-tenantId="@Model.TenantId">@UiText.Get("DosyalaraDon")</a>
<div class="page-heading"><div><span class="eyebrow">@UiText.Get("CEVIRISTUDYOSU")</span><h1 dir="auto">@Model.Job.Title</h1><p class="muted" dir="auto">@Model.Job.SourceLanguageCode → @Model.Job.TargetLanguageCode · @(Model.Job.NotaryRequirement == "Required" ? UiText.Get("NoterGerekli") : UiText.Get("NoterGerekmiyor"))</p></div><span class="badge">@(Model.Historical ? UiText.Get("DosyaninGuncelDurumuBuSurumunOnayiDegildir") : "")@ReviewStateView.Label(Model.Review?.Status ?? "Draft")</span></div>
@if (Model.Message is not null) { <div class="alert" role="alert">@Model.Message</div> }
<partial name="_SubscriptionWriteNotice" model="new SubscriptionWriteNotice(Model.TenantId, Model.WriteStatus)" />
<fieldset class="subscription-lock">
<p><a asp-action="Assignment" asp-route-tenantId="@Model.TenantId" asp-route-jobId="@Model.Job.Id" target="_blank" rel="noopener">@UiText.Get("CevirmenAtamasiVeGecmisiAyriSekmede")</a> · @(Model.Job.AssignedTranslatorUserId.HasValue ? UiText.Get("SorumluCevirmenAtandi") : UiText.Get("CevirmenAtanmadi"))</p>
@if (Model.Document is not null) { <p><a asp-action="SigningPreparation" asp-route-tenantId="@Model.TenantId" asp-route-jobId="@Model.Job.Id" target="_blank" rel="noopener">@UiText.Get("ImzaTalebiniAyriSekmedeHazirla")</a></p> }
@if (Model.Document is null) {
    <section class="card empty"><h2>@UiText.Get("DosyaBaslamayaHazir")</h2><p>@UiText.Get("OnceTaslakBelgeyiOlusturunArdindanSablonSecin")</p><form asp-action="StartDocument" method="post"><input type="hidden" name="tenantId" value="@Model.TenantId" /><input type="hidden" name="jobId" value="@Model.Job.Id" /><button type="submit" disabled="@(!Model.CanWrite)">@UiText.Get("CeviriyiYazmayaBasla")</button></form></section>
} else {
<section class="card document-meta"><span>Son kaydedilen sürüm: @Model.Document.CurrentDraftRevision</span>
<a asp-controller="Settings" asp-action="Templates" asp-route-tenantId="@Model.TenantId" target="_blank" rel="noopener">@UiText.Get("BuCalismaAlanininSablonlariniAyriSekmedeYonet")</a>
@if (Model.Template is not null) { <span>Sabitlenen şablon: sürüm @Model.Template.RevisionNumber</span> }
else if (Model.Document.CurrentDraftRevision == 0) {
    <form asp-action="ApplyTemplate" method="post" id="template-form"><input type="hidden" name="tenantId" value="@Model.TenantId" /><input type="hidden" name="jobId" value="@Model.Job.Id" /><label for="template-select">@UiText.Get("SablonIlkKayittanOnce")</label><select id="template-select" name="templateId" required><option value="">@UiText.Get("SablonSecin")</option>@foreach (var template in Model.Templates.Where(t => t.IsActive)) { <option value="@template.Id" data-revision="@template.CurrentRevision">@template.Name · Sürüm @template.CurrentRevision</option> }</select><input type="hidden" id="template-revision" name="revisionNumber" /><button class="secondary" type="submit" disabled="@(!Model.CanWrite)">@UiText.Get("SablonuSabitle")</button></form>
    <p class="muted">@UiText.Get("IlkKayittanOnceSablonunBaslangicMetniCeviriye")</p>
} else { <span class="muted">@UiText.Get("BuSurumSablonsuzdur")</span> }
@if (Model.Document.CurrentDraftRevision > 0 && !Model.Historical && !Model.Conflict) {
    <p><a asp-action="DocumentTemplate" asp-route-tenantId="@Model.TenantId" asp-route-jobId="@Model.Job.Id" target="_blank" rel="noopener" id="change-template-link">@UiText.Get("SablonuAyriSekmedeBaglaVeyaDegistir")</a></p>
    <p class="muted">@UiText.Get("OnceMetinDegisiklikleriniKaydedinSablonDegisikligiKayitli")</p>
}
</section>
@if (Model.Historical || Model.Conflict) { <div class="notice">@(Model.Historical ? UiText.Get("BuGecmisSurumSaltOkunurdur") : UiText.Get("UzerineYazmayiOnlemekIcinBuSayfadaKayit")) <a asp-action="Editor" asp-route-tenantId="@Model.TenantId" asp-route-jobId="@Model.Job.Id" target="_blank" rel="noopener">@UiText.Get("SonSurumuYeniSekmedeAc")</a></div> }
@if (Model.Review?.Locked == true) { <div class="notice">@UiText.Get("BuDurumdaMetinVeKaynakBelgelerKilitlidir")</div> }
@if (!Model.ContentIsSupported) { <div class="notice">@UiText.Get("BelgeIcerikSurumuDesteklenmiyor")</div> }
<div class="editor-grid" id="editor-workspace" data-tenant-id="@Model.TenantId" data-template-id="@Model.Template?.TemplateId"
     data-content-format="@Model.ContentDescriptor.DisplayFormat" data-content-schema-version="@Model.ContentDescriptor.DisplaySchemaVersion"
     data-template-content-format="@(Model.Template?.ContentDescriptor.DisplayFormat ?? ETranslate.Contracts.Documents.DocumentContentDescriptor.LegacyDisplayFormat)"
     data-template-content-schema-version="@(Model.Template?.ContentDescriptor.DisplaySchemaVersion ?? 0)"
     data-rich-compatible="@compatible.ToString().ToLowerInvariant()" data-editable="@editable.ToString().ToLowerInvariant()"
     data-source-base="@Url.Action("Source", new { tenantId = Model.TenantId, jobId = Model.Job.Id })">
<section class="card source-panel"><div class="section-heading"><h2>@UiText.Get("KaynakBelge")</h2><span class="badge" id="source-count">@sources.Count dosya</span></div>
@if (editable) {
<form asp-action="UploadSource" method="post" enctype="multipart/form-data" id="source-upload-form">
    <input type="hidden" name="tenantId" value="@Model.TenantId" /><input type="hidden" name="jobId" value="@Model.Job.Id" />
    <label for="source-file">@UiText.Get("OzgunDosyaEkle")</label><input type="file" id="source-file" name="file" accept="application/pdf,image/png,image/jpeg,image/tiff,.pdf,.png,.jpg,.jpeg,.tif,.tiff" required />
    <button class="secondary" type="submit">@UiText.Get("KaynakBelgeYukle")</button><p class="muted">@UiText.Get("PDFPNGJPEGVeyaTIFFDosyaBasina")</p>
</form>
}
<p id="source-status" class="muted" role="status">@UiText.Get("DosyalarOzeldirVeBuDosyaKaydinaAittir")</p>
<label for="source-select">@UiText.Get("GoruntulenecekDosya")</label><select id="source-select"><option value="">@UiText.Get("DosyaSecin")</option>
@foreach (var source in sources) { <option value="@source.Id" data-type="@source.ContentType">@source.OriginalFileName</option> }
</select>
<div class="source-actions"><a id="source-download" hidden>@UiText.Get("OzgunDosyayiIndir")</a><div id="pdf-controls" hidden><button type="button" class="quiet" id="pdf-prev" disabled>@UiText.Get("OncekiSayfa")</button><span id="pdf-page-label" role="status"></span><button type="button" class="quiet" id="pdf-next" disabled>@UiText.Get("SonrakiSayfa")</button><label for="source-zoom">@UiText.Get("PDFYakinlastirma")</label><select id="source-zoom"><option value="1">@UiText.Get("Sigdir")</option><option value="1.5">@UiText.Get("150")</option><option value="2">@UiText.Get("200")</option></select></div></div>
<div id="source-display" class="source-display"><p class="empty">@UiText.Get("KaynakDosyayiSecinVeyaYukleyin")</p></div>
<details class="source-files"><summary>@UiText.Get("DosyaEkleri")</summary><div id="source-file-list">
@foreach (var source in sources) { <a asp-action="Source" asp-route-tenantId="@Model.TenantId" asp-route-jobId="@Model.Job.Id" asp-route-sourceFileId="@source.Id" asp-route-download="true">@source.OriginalFileName <span class="muted">(@((source.SizeBytes / 1024d).ToString("0.#")) KB)</span></a> }
</div></details><p class="muted">@UiText.Get("TIFFYalnizcaIndirilebilirPDFOnizlemesiGorseldirArama")</p>
</section>
<section class="card editor-controls"><div class="section-heading"><h2 id="editor-heading">@UiText.Get("CeviriMetni")</h2><span id="save-state" class="muted" role="status">@UiText.Get("OtomatikKayitYok")</span></div>
<div id="editor-view-controls" class="editor-view-controls" role="group" aria-label="@UiText.Get("EditorViewControls")" hidden>
    <button type="button" class="secondary" id="editor-focus-toggle" aria-pressed="false">@UiText.Get("EditorEnterFocus")</button>
    <label for="editor-zoom">@UiText.Get("EditorZoom")</label><select id="editor-zoom" aria-describedby="editor-paper-description"><option value="fit">@UiText.Get("EditorFitWidth")</option><option value="75">75%</option><option value="100">100%</option><option value="125">125%</option><option value="150">150%</option></select>
    <span id="editor-zoom-status" class="muted" role="status"></span>
    <button type="button" class="secondary" id="editor-pages-toggle" aria-pressed="false">@UiText.Get("EditorEnablePages")</button>
</div>
<nav id="editor-pages-nav" class="editor-pagination-nav" aria-label="@UiText.Get("EditorPageNavigation")" hidden>
    <button id="editor-page-prev" type="button">@UiText.Get("OncekiSayfa")</button><label for="editor-page-index">@UiText.Get("EditorGoToPage")</label><select id="editor-page-index"></select>
    <button id="editor-page-next" type="button">@UiText.Get("SonrakiSayfa")</button><span id="editor-page-count" role="status"></span>
</nav><p id="editor-pagination-status" class="muted" role="status"></p>
<form asp-action="SaveDraft" method="post" id="draft-form"><input type="hidden" name="tenantId" value="@Model.TenantId" /><input type="hidden" name="jobId" value="@Model.Job.Id" /><input type="hidden" name="expectedRevision" value="@Model.ExpectedRevision" /><input type="hidden" name="mode" value="@(plain is null ? "json" : "text")" />
<div id="rich-region" hidden><partial name="_EditorTextTools" /><partial name="_EditorTypography" /><partial name="_EditorParagraph" /><div class="editor-toolbar" role="toolbar" aria-label="@UiText.Get("CeviriBicimlendirme")">
    <button type="button" data-command="bold" aria-label="@UiText.Get("KalinMetin")" aria-pressed="false"><strong>B</strong></button>
    <button type="button" data-command="italic" aria-label="@UiText.Get("ItalikMetin")" aria-pressed="false"><em>I</em></button>
    <button type="button" data-command="underline" aria-label="@UiText.Get("AltiCizili")" aria-pressed="false"><u>U</u></button>
    <button type="button" data-command="strike" aria-label="@UiText.Get("EditorStrike")" title="@UiText.Get("EditorStrike")" aria-pressed="false"><s>S</s></button>
    <button type="button" data-command="superscript" aria-label="@UiText.Get("EditorSuperscript")" title="@UiText.Get("EditorSuperscript")" aria-pressed="false">x<sup>2</sup></button>
    <button type="button" data-command="subscript" aria-label="@UiText.Get("EditorSubscript")" title="@UiText.Get("EditorSubscript")" aria-pressed="false">x<sub>2</sub></button>
    <button type="button" data-command="paragraph">@UiText.Get("Paragraf")</button><button type="button" data-command="heading" aria-pressed="false">@UiText.Get("Baslik")</button>
    <button type="button" data-command="bulletList" aria-pressed="false">@UiText.Get("MaddeIsaretliListe")</button><button type="button" data-command="orderedList" aria-pressed="false">@UiText.Get("NumaraliListe")</button>
    <button type="button" data-command="rtl" aria-label="@UiText.Get("SagdanSolaYon")">@UiText.Get("SagdanSola")</button><button type="button" data-command="ltr" aria-label="@UiText.Get("SoldanSagaYon")">@UiText.Get("SoldanSaga")</button><button type="button" data-command="auto">@UiText.Get("OtomatikYon")</button>
    <button type="button" data-command="undo">@UiText.Get("GeriAl")</button><button type="button" data-command="redo">@UiText.Get("Yinele")</button>
    <button type="button" data-command="insertTable" aria-describedby="editor-table-size">@UiText.Get("EditorInsertTable")</button>
    <button type="button" data-command="addRowAfter">@UiText.Get("SonrakiSatir")</button><button type="button" data-command="addColumnAfter">@UiText.Get("SonrakiSutun")</button>
    <button type="button" data-command="deleteRow">@UiText.Get("SatiriSil")</button><button type="button" data-command="deleteColumn">@UiText.Get("SutunuSil")</button><button type="button" data-command="deleteTable">@UiText.Get("TabloyuSil")</button>
    <button type="button" data-command="toggleTableHeaderRow" aria-pressed="false" title="@UiText.Get("EditorToggleTableHeaderHelp")">@UiText.Get("EditorToggleTableHeader")</button>
    <partial name="_EditorTable" />
</div><p id="editor-paper-description" class="muted"></p><div id="editor-viewport" class="editor-viewport" tabindex="0" role="region" aria-label="@UiText.Get("EditorPaperRegion")" aria-describedby="editor-paper-description"><div id="editor-paper-stage"><div id="editor-paper"><div id="rich-text"></div></div></div></div><p class="muted">@UiText.Get("BicimlendirmeSeciliMetneVeyaGecerliParagrafaUygulanir")</p></div>
<p id="editor-format-status" class="muted" role="status"></p>
@if (plain is not null) { <label for="translation-text">@UiText.Get("HerSatirBirParagraf")</label><textarea id="translation-text" name="plainText" rows="18" dir="auto" readonly="@(!editable)" maxlength="1000000">@plain</textarea><textarea id="document-json" name="editorContentJson" hidden>@Model.EditorContentJson</textarea> }
else { <p class="notice" id="legacy-format-notice">@UiText.Get("BelgeninOzgunYapisiKorunmusturZenginDuzenleyiciBu")</p><label for="document-json">@UiText.Get("BelgeYapisiGelismisDuzenleme")</label><textarea id="document-json" name="editorContentJson" rows="18" dir="ltr" readonly="@(!editable)" maxlength="2000000">@Model.EditorContentJson</textarea> }
<button type="submit" disabled="@(!editable)">@UiText.Get("YeniSurumuKaydet")</button><p class="muted">@UiText.Get("YalnizcaCeviriGovdesiDegisirSabitlenenSablonunUstbilgisi")</p></form>
<p><a asp-action="Editor" asp-route-tenantId="@Model.TenantId" asp-route-jobId="@Model.Job.Id" target="_blank" rel="noopener">@UiText.Get("SonSurumuYeniSekmedeIncele")</a> · <a asp-controller="Account" asp-action="Login" target="_blank" rel="noopener">@UiText.Get("YenidenGiris")</a></p>
<details><summary>Sürüm geçmişi (@Model.History.Count)</summary><div class="history">@foreach (var revision in Model.History) { <a asp-action="Editor" asp-route-tenantId="@Model.TenantId" asp-route-jobId="@Model.Job.Id" asp-route-revisionNumber="@revision.RevisionNumber">Sürüm @revision.RevisionNumber <span dir="ltr">@revision.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span></a> }</div></details>
<section class="draft-pdf-section"><h3>@UiText.Get("TaslakPDFImzasiz")</h3>
@if (Model.ViewedRevision > 0) {
    <form asp-action="GenerateDraftPdf" method="post" id="draft-pdf-form" data-download-base="@Url.Action("DraftPdf", new { tenantId = Model.TenantId, jobId = Model.Job.Id })">
        <input type="hidden" name="tenantId" value="@Model.TenantId" /><input type="hidden" name="jobId" value="@Model.Job.Id" /><input type="hidden" name="revisionNumber" value="@Model.ViewedRevision" />
        <button type="submit" class="secondary" disabled="@(!Model.CanWrite || !Model.ContentIsSupported)">Kaydedilen sürümden PDF oluştur: @Model.ViewedRevision</button>
    </form>
} else { <p class="muted">@UiText.Get("PDFOlusturmakIcinOnceBirCeviriSurumu")</p> }
<p class="muted">@UiText.Get("YalnizcaKayitliSurumYazdirilirKaydedilmemisDegisikliklerPDF")</p>
<p id="draft-pdf-status" role="status" class="muted"></p><div id="draft-pdf-list">
@foreach (var pdf in Model.PdfVersions) {
    <div data-pdf-id="@pdf.Id"><a asp-action="DraftPdf" asp-route-tenantId="@Model.TenantId" asp-route-jobId="@Model.Job.Id" asp-route-pdfId="@pdf.Id">Taslak PDF indir, sürüm @pdf.RevisionNumber</a><small dir="ltr">SHA-256: @pdf.Sha256</small></div>
}
</div></section>
<partial name="_DocumentReview" model="Model" />
</section>
<details class="preview-panel"><summary>@UiText.Get("UstbilgiVeSablonlaCeviriOnizlemesi")</summary><p class="muted">@UiText.Get("YaklasikOnizlemedirNihaiPDFDegildirYazdirmadanOnce")</p><label for="preview-page-role">@UiText.Get("OrnekOnizlemeSayfasi")</label><select id="preview-page-role"><option value="Last">@UiText.Get("SonSayfaVeyaTekSayfalikBelge")</option><option value="Earlier">@UiText.Get("SonSayfadanOncekiBirSayfa")</option></select><div id="preview-notice" class="muted" role="status"></div><article class="paper" dir="auto"><div class="watermark" id="preview-watermark"></div><header id="preview-header" class="paper-header"></header><div id="preview-body" class="paper-body"></div><footer id="preview-footer" class="paper-footer"></footer></article></details>
</div>
<div hidden><textarea id="template-header" dir="auto">@Model.Template?.HeaderContentJson</textarea><textarea id="template-footer" dir="auto">@Model.Template?.FooterContentJson</textarea><textarea id="template-watermark" dir="auto">@Model.Template?.WatermarkJson</textarea><textarea id="template-layout" dir="auto">@Model.Template?.PageLayoutJson</textarea></div>
}
</fieldset>
@section Scripts {
    <script type="module" src="~/js/generated/workspace.js" asp-append-version="true"></script>
}
