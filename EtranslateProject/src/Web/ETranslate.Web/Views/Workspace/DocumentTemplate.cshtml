@model EditorView
@{ ViewData["Title"] = UiText.Get("DosyaSablonu"); var canChange = Model.CanWrite && Model.Review is { Locked: false, CanManage: true }; }
<a asp-action="Editor" asp-route-tenantId="@Model.TenantId" asp-route-jobId="@Model.Job.Id" target="_blank" rel="noopener">@UiText.Get("SonSurumuAyriSekmedeAc")</a>
<div class="page-heading"><div><h1>@UiText.Get("DosyaSablonu")</h1><p>@Model.Job.Title · Kaydedilen sürüm: @Model.ExpectedRevision</p></div></div>
<partial name="_SubscriptionWriteNotice" model="new SubscriptionWriteNotice(Model.TenantId, Model.WriteStatus)" />
<section class="card"><h2>@UiText.Get("MetniKoruyarakSablonBaglaVeyaDegistir")</h2>
    <p>Mevcut şablon: @(Model.Template is null ? UiText.Get("Sablonsuz") : $"{Model.Templates.FirstOrDefault(t => t.Id == Model.Template.TemplateId)?.Name ?? UiText.Get("SecilenSablon")} · Sürüm {Model.Template.RevisionNumber}")</p>
    <p class="notice">@UiText.Get("OnceDuzenleyicidekiDegisiklikleriKaydedipBuSayfayiYenileyin")</p>
    <p class="muted">@UiText.Get("OncekiPDFDosyalariGecmisVeSurumlerDegismez")</p>
    @if (!canChange) { <p class="notice">@UiText.Get("BuDurumdaSablonDegistirilemezYazmaYetkisiVe")</p> }
    <form asp-action="ChangeDocumentTemplate" method="post" id="document-template-change-form">
        <input type="hidden" name="tenantId" value="@Model.TenantId" /><input type="hidden" name="jobId" value="@Model.Job.Id" /><input type="hidden" name="expectedRevision" value="@Model.ExpectedRevision" />
        <fieldset disabled="@(!canChange)" class="subscription-lock"><label for="template-select">@UiText.Get("HedefSablonHerSablonunGuncelSurumu")</label>
        <select id="template-select" name="templateId" required><option value="">@UiText.Get("Secin")</option>@foreach (var template in Model.Templates.Where(t => t.IsActive)) { <option value="@template.Id" data-revision="@template.CurrentRevision">@template.Name · Sürüm @template.CurrentRevision</option> }</select>
        <input type="hidden" id="template-revision" name="revisionNumber" /><button type="submit">@UiText.Get("YeniSurumOlusturarakSablonuKaydet")</button></fieldset>
    </form>
</section>
