<details id="editor-horizontal-merge" class="editor-horizontal-merge">
    <summary>@UiText.Get("EditorHorizontalMerge")</summary>
    <p class="muted">@UiText.Get("EditorHorizontalMergeHelp")</p>
    <button type="button" data-command="mergeNextCell">@UiText.Get("EditorMergeNextCell")</button>
    <button type="button" data-command="mergeCellsInRow">@UiText.Get("EditorMergeSelectedCells")</button>
    <button type="button" data-command="splitCellInRow">@UiText.Get("EditorSplitCellInRow")</button>
</details>
