<details id="editor-clipboard" class="editor-clipboard">
    <summary>@UiText.Get("EditorPastePanel")</summary>
    <label for="editor-paste-mode">@UiText.Get("EditorPasteMode")</label>
    <select id="editor-paste-mode"><option value="formatted">@UiText.Get("EditorPasteFormatted")</option><option value="plain">@UiText.Get("EditorPastePlain")</option></select>
    <p class="muted">@UiText.Get("EditorPasteHelp")</p>
</details>
<p id="editor-paste-status" class="editor-paste-status muted" role="status" aria-live="polite" hidden></p>
