<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · ETranslate</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar"><a class="brand" asp-controller="Workspace" asp-action="Index"><span class="brand-icon">E</span><span dir="ltr">ETranslate<span class="brand-sub">TRANSLATION WORKSPACE</span></span></a>
        <nav aria-label="ناوبری اصلی">@if (User.Identity?.IsAuthenticated == true) {
            <a asp-controller="Workspace" asp-action="Index">فضای کاری</a><span class="account" dir="ltr">@User.Identity.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="quiet" type="submit">خروج</button></form>
        } else { <a asp-controller="Account" asp-action="Login">ورود</a><a asp-controller="Account" asp-action="Register">ساخت حساب</a> }</nav>
    </header>
    <main class="shell">@if (TempData["Notice"] is string notice) { <div class="notice" role="status">@notice</div> } @RenderBody()</main>
    <footer class="site-footer"><span dir="ltr">ETranslate © 2026</span><span>نسخه‌ی توسعه · متن پیش‌نویس، بدون امضای الکترونیکی</span></footer>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
