@model Microsoft.AspNetCore.Mvc.ModelBinding.ModelStateDictionary
@{ var errors = Model.Values.SelectMany(entry => entry.Errors).Select(error => string.IsNullOrWhiteSpace(error.ErrorMessage)
       ? UiText.Get("FormValidationError") : error.ErrorMessage).Distinct().ToArray(); }
@if (errors.Length > 0) {
    <div class="alert validation-summary-errors" role="alert"><ul>
        @foreach (var error in errors) { <li>@error</li> }
    </ul></div>
}
