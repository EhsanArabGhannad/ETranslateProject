@model AppNavigation
<nav class="app-navigation" aria-label="منوی اصلی">
    <a asp-controller="Workspace" asp-action="Index" asp-route-tenantId="@Model.TenantId" class="@(Model.Section == "jobs" ? "current" : "")" aria-current="@(Model.Section == "jobs" ? "page" : null)">پرونده‌ها</a>
    <a asp-controller="Workspace" asp-action="Index" asp-route-tenantId="@Model.TenantId" asp-route-assignedToMe="true" class="@(Model.Section == "tasks" ? "current" : "")" aria-current="@(Model.Section == "tasks" ? "page" : null)">کارهای من</a>
    @if (Model.TenantId.HasValue) {
        @if (Model.CanManageTeam) { <a asp-controller="Team" asp-action="Index" asp-route-tenantId="@Model.TenantId" class="@(Model.Section == "team" ? "current" : "")" aria-current="@(Model.Section == "team" ? "page" : null)">اعضای تیم</a> }
        <a asp-controller="Subscription" asp-action="Index" asp-route-tenantId="@Model.TenantId" class="@(Model.Section == "subscription" ? "current" : "")" aria-current="@(Model.Section == "subscription" ? "page" : null)">اشتراک</a>
    }
    <a asp-controller="Settings" asp-action="Index" asp-route-tenantId="@Model.TenantId" class="@(Model.Section == "settings" ? "current" : "")" aria-current="@(Model.Section == "settings" ? "page" : null)">تنظیمات</a>
    @if (!string.IsNullOrWhiteSpace(Model.TenantName)) { <span class="navigation-tenant">فضای کاری: @Model.TenantName</span> }
</nav>
