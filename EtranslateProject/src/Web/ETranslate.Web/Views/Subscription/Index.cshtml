@model SubscriptionPageView
@{ ViewData["Title"] = UiText.Get("AbonelikDurumu"); }
<a class="back-link" asp-controller="Workspace" asp-action="Index" asp-route-tenantId="@Model.Tenant.Id">@UiText.Get("CalismaAlaninaDon2")</a>
<div class="page-heading"><div><span class="eyebrow">@UiText.Get("ABONELIKSALTOKUNUR")</span><h1>@UiText.Get("AbonelikDurumu")</h1><p>@Model.Tenant.Name</p></div><span class="badge">@(Model.Tenant.Type == "TranslationOffice" ? UiText.Get("TercumeBurosu") : UiText.Get("BagimsizCevirmen"))</span></div>
<section class="card" aria-label="@UiText.Get("AbonelikBilgileri")">
@if (Model.Tenant.Role is "Owner" or "Administrator") { <p><a asp-controller="PurchaseOrders" asp-action="Index" asp-route-tenantId="@Model.Tenant.Id">@UiText.Get("SatinAlmaVeyaYenilemeOnSiparisiOdeme")</a></p> }
@if (Model.Error is not null) {
    <p class="notice" role="alert">@Model.Error</p>
} else if (Model.Subscription is { } subscription) {
    <h2>@subscription.StatusLabel</h2>
    @if (subscription.Status == "Pending") {
        <p class="notice">@UiText.Get("CalismaAlaniOlusturulduAncakOtomatikAbonelikKaydi")</p>
    } else {
        <p>Plan: @(subscription.PlanCode == "trial" ? UiText.Get("UcretsizDeneme30Gun") : subscription.PlanCode)</p>
        @if (subscription.PaidStartsAtUtc is { } paidStart && subscription.PaidEndsAtUtc is { } paidEnd) {
            <h3>@(paidStart > subscription.ObservedAtUtc ? UiText.Get("UcretliDonemDenemedenSonraBaslar") : UiText.Get("UcretliErisimDonemi"))</h3>
            <p>@subscription.PaidPlanName · @subscription.PaidMonths kayıtlı takvim ayı</p>
            <p>@UiText.Get("UcretliErisimBaslangici") <time datetime="@paidStart.ToString("O")" dir="ltr">@SubscriptionView.IstanbulTime(paidStart)</time></p>
            <p>@UiText.Get("UcretliErisimSonu") <time datetime="@paidEnd.ToString("O")" dir="ltr">@SubscriptionView.IstanbulTime(paidEnd)</time></p>
            <p>Ücretli erişimde kalan gün: @subscription.RemainingPaidDays gün</p>
            <p class="muted">@UiText.Get("BuBilgilerBillingHizmetindekiKayitliDurumdurOdeme")</p>
        }
        @if (subscription.RemainingTrialDays is { } days) {
            <p>@UiText.Get("KalanSure") <strong>@days gün</strong></p>
            @if (subscription.Status == "Trialing") { <p class="muted">@UiText.Get("KalanGunYukariYuvarlanir24SaattenAz")</p> }
        }
        @if (subscription.TrialStartedAtUtc is { } start) { <p>@UiText.Get("DenemeBaslangici") <time datetime="@start.ToString("O")" dir="ltr">@SubscriptionView.IstanbulTime(start)</time></p> }
        @if (subscription.TrialEndsAtUtc is { } end) { <p>@UiText.Get("DenemeSonu") <time datetime="@end.ToString("O")" dir="ltr">@SubscriptionView.IstanbulTime(end)</time></p> }
        @if (subscription.Status is "Expired" or "Canceled" or "PastDue") { <p class="notice">@UiText.Get("GecerliAbonelikGerekirCalismaAlaniSaltOkunurdur2")</p> }
    }
    <p class="muted">@UiText.Get("KontrolZamani") <time datetime="@subscription.ObservedAtUtc.ToString("O")" dir="ltr">@SubscriptionView.IstanbulTime(subscription.ObservedAtUtc)</time> @UiText.Get("TumSaatlerIstanbulSaatineUTC03002")</p>
}
<p><a class="back-link" asp-action="Index" asp-route-tenantId="@Model.Tenant.Id">@UiText.Get("AbonelikDurumunuYenidenKontrolEt")</a></p>
</section>
<section class="card"><h2>@UiText.Get("AbonelikKurallari")</h2><p>@UiText.Get("AbonelikCalismaAlaninaAittirEtkinUyelerAyni")</p><p class="muted">@UiText.Get("DegisiklikIslemleriIcinGecerliAbonelikVeYetkili")</p></section>
