@model LoginInput
@{ var register = ViewContext.RouteData.Values["action"]?.ToString() == "Register"; ViewData["Title"] = register ? UiText.Get("HesapOlustur") : UiText.Get("Giris"); }
<section class="auth-grid">
    <div class="intro"><span class="eyebrow">@UiText.Get("ETranslateCALISMAALANI")</span><h1>@UiText.Get("CevirideNetBirYol")</h1><p>@UiText.Get("DosyalariOzelSablonlariVeCeviriSurumleriniKendi")</p><div class="steps"><span>@UiText.Get("1Hazirlik")</span><span>@UiText.Get("2Inceleme")</span><span>@UiText.Get("3ImzaSonrakiAsamada")</span></div><p class="muted">@UiText.Get("GelistirmeSurumuBuAsamadakiTaslaklarImzaliBelge")</p></div>
    <div class="card auth-card"><span class="eyebrow">@UiText.Get("Baslangic")</span><h2>@ViewData["Title"]</h2>
        <form asp-action="@(register ? "Register" : "Login")" method="post">
            <div asp-validation-summary="All" class="alert" role="alert"></div>
            <label asp-for="Email">@UiText.Get("EPosta")</label><input asp-for="Email" type="email" autocomplete="username" dir="ltr" maxlength="254" required />
            <label asp-for="Password">@UiText.Get("Sifre")</label><input asp-for="Password" type="password" autocomplete="@(register ? "new-password" : "current-password")" dir="ltr" required maxlength="256" />
            @if (register) { <p class="muted">@UiText.Get("EnAz6KarakterBuyukVeKucuk")</p> }
            <button type="submit">@(register ? UiText.Get("HesapOlusturVeGirisYap") : UiText.Get("CalismaAlaninaGirisYap"))</button>
        </form>
        <p>@(register ? UiText.Get("HesabinizVarMi") : UiText.Get("HenuzHesabinizYokMu")) <a asp-action="@(register ? "Login" : "Register")">@(register ? UiText.Get("Giris") : UiText.Get("KayitOl"))</a></p>
    </div>
</section>
