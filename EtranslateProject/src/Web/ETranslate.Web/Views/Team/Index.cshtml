@model TeamPageView
@{ ViewData["Title"] = UiText.Get("UyelerVeRoller"); var team = Model.Team; }
<a class="back-link" asp-controller="Workspace" asp-action="Index" asp-route-tenantId="@team.TenantId">@UiText.Get("CalismaAlaninaDon2")</a>
<div class="page-heading"><div><span class="eyebrow">@UiText.Get("EKIPVEERISIM")</span><h1>@UiText.Get("UyelerVeRoller")</h1><p>@team.TenantName · Rolünüz: @TeamPageView.RoleLabel(team.Role)</p></div><span class="badge">Ekip sürümü @team.TeamVersion</span></div>
@if (Model.Message is not null) { <div class="alert" role="alert">@Model.Message</div> }
@if (Model.Created is { } created) {
    <section class="card"><h2>@UiText.Get("TekKullanimlikDavetBaglantisiHazir")</h2><p>@UiText.Get("Kisi") <span dir="ltr">@created.Email</span> Rol: @TeamPageView.RoleLabel(created.Role). Son geçerlilik: <span dir="ltr">@created.ExpiresAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span></p>
        <p class="notice">@UiText.Get("BuGizliBaglantiYalnizcaSimdiGosterilirIlgili")</p>
        <label for="invitation-link">@UiText.Get("DavetBaglantisiKopyalayin")</label><input id="invitation-link" dir="ltr" readonly value="@Model.InviteLink" data-relative-link="true" />
        <label for="invitation-token">@UiText.Get("ElleGirisIcinDavetKodu")</label><input id="invitation-token" dir="ltr" readonly value="@created.Token" />
        <p>@UiText.Get("DavetEdilenKisiKayitliHesabiylaGirisYapmalidir")</p>
    </section>
}
<div class="workspace-grid"><section class="card"><h2>Çalışma alanı üyeleri (@team.Members.Count)</h2>
@foreach (var member in team.Members) {
    <article class="team-member"><h3 dir="ltr">@member.Email</h3><p>@TeamPageView.RoleLabel(member.Role) · @(member.IsActive ? UiText.Get("Etkin") : UiText.Get("DevreDisi"))</p>
    @if (member.CanEdit) {
        <form asp-action="Role" method="post"><input type="hidden" name="tenantId" value="@team.TenantId" /><input type="hidden" name="userId" value="@member.UserId" /><input type="hidden" name="expectedTeamVersion" value="@team.TeamVersion" />
            <label for="role-@member.UserId">@UiText.Get("Rol")</label><select id="role-@member.UserId" name="role">
            @if (team.Role == "Owner") { <option value="Administrator" selected="@(member.Role == "Administrator")">@UiText.Get("Yonetici")</option> }
            <option value="Translator" selected="@(member.Role == "Translator")">@UiText.Get("Cevirmen")</option><option value="Reviewer" selected="@(member.Role == "Reviewer")">@UiText.Get("GozlemciSaltOkunur")</option></select><button class="secondary" type="submit">@UiText.Get("RoluKaydet")</button>
        </form>
        <form asp-action="Status" method="post"><input type="hidden" name="tenantId" value="@team.TenantId" /><input type="hidden" name="userId" value="@member.UserId" /><input type="hidden" name="expectedTeamVersion" value="@team.TeamVersion" /><input type="hidden" name="isActive" value="@((!member.IsActive).ToString().ToLowerInvariant())" /><button class="secondary" type="submit">@(member.IsActive ? UiText.Get("ErisimiDevreDisiBirak") : UiText.Get("YenidenEtkinlestir"))</button></form>
    } else { <p class="muted">@UiText.Get("AlanSahibiKendiRolunuzVeYetkinizDisindaki")</p> }
    </article>
}
</section><aside class="card"><h2>@UiText.Get("YeniUyeDavetEt")</h2><p class="muted">@UiText.Get("IlgiliKisiOnceHesapOlusturmalidirDavet7")</p>
<form asp-action="Invite" method="post"><input type="hidden" name="tenantId" value="@team.TenantId" /><input type="hidden" name="expectedTeamVersion" value="@team.TeamVersion" />
    <label for="invite-email">@UiText.Get("KayitliHesabinEPostaAdresi")</label><input type="email" id="invite-email" name="email" dir="ltr" maxlength="256" value="@Model.Email" required />
    <label for="invite-role">@UiText.Get("DavetEdilenKisininRolu")</label><select id="invite-role" name="role">
    @if (team.Role == "Owner") { <option value="Administrator" selected="@(Model.Role == "Administrator")">@UiText.Get("Yonetici")</option> }
    <option value="Translator" selected="@(Model.Role == "Translator")">@UiText.Get("Cevirmen")</option><option value="Reviewer" selected="@(Model.Role == "Reviewer")">@UiText.Get("GozlemciSaltOkunur")</option></select><button type="submit">@UiText.Get("TekKullanimlikDavetOlustur")</button>
</form><p class="muted">@UiText.Get("YoneticiIncelemeyiOnaylayabilirCevirmenYazarVeIncelemeye")</p></aside></div>
<section class="card"><h2>@UiText.Get("DavetlerEnSon100Davet")</h2>
@foreach (var invitation in team.Invitations) {
    <article class="team-member"><h3 dir="ltr">@invitation.Email</h3><p>@TeamPageView.RoleLabel(invitation.Role) · @(invitation.IsExpired ? UiText.Get("SuresiDoldu") : invitation.Status == "Pending" ? UiText.Get("KabulBekliyor") : invitation.Status == "Accepted" ? UiText.Get("KabulEdildi") : UiText.Get("IptalEdildi")) · Son geçerlilik: <span dir="ltr">@invitation.ExpiresAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span></p>
        @if (invitation.CanCancel) { <form asp-action="Cancel" method="post"><input type="hidden" name="tenantId" value="@team.TenantId" /><input type="hidden" name="invitationId" value="@invitation.Id" /><input type="hidden" name="expectedTeamVersion" value="@team.TeamVersion" /><button class="secondary" type="submit">@UiText.Get("DavetiIptalEt")</button></form> }
    </article>
}
</section><section class="card"><details><summary>@UiText.Get("EkipDegisiklikGecmisiEnSon50Degisiklik")</summary>
@foreach (var entry in team.Audit) { <p>@TeamPageView.ActionLabel(entry.Action) · Sürüm @entry.TeamVersion · @TeamPageView.RoleLabel(entry.PreviousRole) → @TeamPageView.RoleLabel(entry.Role)<br /><small dir="ltr">@entry.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm") UTC · Actor: @entry.ActorUserId · Member: @entry.TargetUserId</small></p> }
</details><p class="muted">@UiText.Get("DevreDisiBirakmaYalnizcaBuCalismaAlanina")</p></section>
@section Scripts { <script src="~/js/team-invitations.js" asp-append-version="true"></script> }
