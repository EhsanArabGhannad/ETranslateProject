@model AcceptInvitationView
@{ ViewData["Title"] = UiText.Get("DavetiKabulEt"); }
<section class="card"><span class="eyebrow">@UiText.Get("EKIPDAVETI")</span><h1>@UiText.Get("CalismaAlaniDavetiniKabulEt")</h1>
@if (Model.Message is not null) { <p class="alert" role="alert">@Model.Message</p> }
@if (Model.Invitation is { } invitation) {
    <p>@invitation.TenantName · Önerilen rol: @TeamPageView.RoleLabel(invitation.Role)</p>
    <p>@UiText.Get("SonGecerlilik") <span dir="ltr">@invitation.ExpiresAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span></p>
    @if (!invitation.CanAccept) { <p class="notice">@UiText.Get("BuDavetArtikKabulEdilemezYoneticidenYeni")</p> }
}
<p class="muted">@UiText.Get("KabulEderekYukaridakiCalismaAlaninaUyeOlursunuz")</p>
<form asp-action="Accept" method="post"><input type="hidden" name="invitationId" value="@Model.InvitationId" />
    <label for="accept-token">@UiText.Get("GizliDavetKodu")</label><input id="accept-token" name="token" dir="ltr" minlength="43" maxlength="43" required autocomplete="off" />
    <button type="submit" disabled="@(Model.Invitation is { CanAccept: false })">@UiText.Get("KabulEtVeCalismaAlaninaGir")</button>
</form><p><a asp-controller="Workspace" asp-action="Index">@UiText.Get("KabulEtmedenGeriDon")</a></p></section>
@section Scripts { <script src="~/js/team-invitations.js" asp-append-version="true"></script> }
