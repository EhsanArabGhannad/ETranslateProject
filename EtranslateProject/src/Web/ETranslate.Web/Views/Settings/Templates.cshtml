@model SettingsPageView
@{ ViewData["Title"] = UiText.Get("AyarlarSablonlar"); }
<a class="back-link" asp-action="Index" asp-route-tenantId="@Model.Tenant?.Id">@UiText.Get("AyarlaraDon")</a>
<div class="page-heading"><div><span class="eyebrow">@UiText.Get("AYARLARSABLONLAR")</span><h1>@UiText.Get("Sablonlar")</h1><p class="muted">@(Model.Tenant?.Name ?? UiText.Get("OnceBirCalismaAlaniOlusturun"))</p></div></div>
@if (Model.Tenants.Count > 0) {
    <nav class="tenant-tabs" aria-label="@UiText.Get("CalismaAlanlari")">@foreach (var tenant in Model.Tenants) { <a class="@(tenant.Id == Model.Tenant?.Id ? "selected" : "")" asp-action="Templates" asp-route-tenantId="@tenant.Id">@tenant.Name</a> }</nav>
}
@if (Model.Tenant is null) { <section class="card empty"><h2>@UiText.Get("HenuzCalismaAlaninizYok")</h2><a asp-controller="Workspace" asp-action="Index">@UiText.Get("CalismaAlaniOlustur")</a></section> }
else {
    <partial name="_SubscriptionWriteNotice" model="new SubscriptionWriteNotice(Model.Tenant.Id, Model.WriteStatus)" />
    @if (Model.Message is not null) { <div class="alert" role="alert">@Model.Message</div> }
    @if (Model.Tenant.Role == "Reviewer") { <p class="notice">@UiText.Get("SablonlarSizinIcinSaltOkunurdur")</p> }
    <section class="card">
        <form asp-action="Templates" method="get" id="template-picker-form">
            <input type="hidden" name="tenantId" value="@Model.Tenant.Id" />
            <label for="template-picker">@UiText.Get("DuzenlenecekSablonuSecin")</label>
            <select id="template-picker" name="templateId"><option value="" selected="@(Model.Selected is null)">@UiText.Get("YeniSablon")</option>
                @foreach (var template in Model.Templates) { <option value="@template.Id" selected="@(Model.Selected?.Id == template.Id)">@template.Name · Sürüm @template.CurrentRevision @(template.IsActive ? "" : UiText.Get("Arsivlenmis"))</option> }
            </select><button class="secondary" type="submit">@UiText.Get("SablonuGoster")</button>
        </form>
    </section>
    <section class="card">
        <h2 class="template-heading">@(Model.Selected is null ? UiText.Get("YeniSablonOlustur") : UiText.Format("EditTemplateRevision", Model.Selected.Name, Model.Selected.CurrentRevision))</h2>
        @if (Model.Selected?.IsActive == false) { <p class="notice">@UiText.Get("ArsivlenmisSablonSaltOkunurdur")</p> }
        @if (Model.Selected is { Revision.ContentDescriptor.IsSupported: false }) { <p class="notice">@UiText.Get("BelgeIcerikSurumuDesteklenmiyor")</p> }
        @if (Model.Selected is not null) { <p><a asp-action="Templates" asp-route-tenantId="@Model.Tenant.Id" asp-route-templateId="@Model.Selected.Id" asp-route-pendingAssetId="@Model.Form.PendingAssetId" target="_blank" rel="noopener">@UiText.Get("SonSurumuAyriSekmedeIncele")</a></p> }
        <form asp-action="SaveTemplate" method="post" enctype="multipart/form-data" id="template-edit-form" data-discard-confirm="@UiText.Get("DiscardTemplateChanges")" data-invalid-logo="@UiText.Get("InvalidLogo")">
            <div asp-validation-summary="All" class="alert"></div>
            <input asp-for="Form.TenantId" type="hidden" /><input asp-for="Form.TemplateId" type="hidden" /><input asp-for="Form.ExpectedRevision" type="hidden" /><input asp-for="Form.PendingAssetId" type="hidden" />
            <input asp-for="Form.HeaderLineAlignmentsJson" id="header-alignments" type="hidden" /><input asp-for="Form.FooterLineAlignmentsJson" id="footer-alignments" type="hidden" />
            <fieldset disabled="@(!Model.CanSave)" class="subscription-lock">
                <label for="template-name">@UiText.Get("SablonAdi")</label><input asp-for="Form.Name" id="template-name" maxlength="200" required readonly="@(Model.Selected is not null)" dir="auto" />
                @if (Model.Selected is not null) { <p class="muted">@UiText.Get("BuSablonunAdiSabittirFarkliBirAd")</p> }
                <label for="header-text">@UiText.Get("UstbilgiMetni")</label><textarea asp-for="Form.Header" id="header-text" rows="3" maxlength="10000" readonly="@(!Model.Projection.HeaderEditable)" dir="auto"></textarea>
                <details><summary>@UiText.Get("UstbilgiSatirlariniAyriAyriHizala")</summary><div id="header-line-controls" class="template-line-controls"></div></details>
                @if (!Model.Projection.HeaderEditable) { <p class="notice">@UiText.Get("UstbilgiKarmasikYapidadirBuBasitFormdaDegistirilmez")</p> }
                <label for="starter">@UiText.Get("BaslangicCeviriMetni")</label><textarea asp-for="Form.StarterText" id="starter" rows="5" maxlength="50000" readonly="@(!Model.Projection.BodyEditable)" dir="auto"></textarea>
                @if (!Model.Projection.BodyEditable) { <p class="notice">@UiText.Get("BaslangicMetniZenginBicimlendirmeIcerirBuForm")</p> }
                <label for="footer-text">@UiText.Get("AltbilgiMetni")</label><textarea asp-for="Form.Footer" id="footer-text" rows="2" maxlength="2000" readonly="@(!Model.Projection.FooterEditable)" dir="auto"></textarea>
                <details><summary>@UiText.Get("AltbilgiSatirlariniAyriAyriHizala")</summary><div id="footer-line-controls" class="template-line-controls"></div></details>
                @if (!Model.Projection.FooterEditable) { <p class="notice">@UiText.Get("AltbilgiKarmasikYapidadirOzgunSurumuKorunur")</p> }
                <fieldset disabled="@(!Model.Projection.LayoutEditable)" class="subscription-lock">
                    <label for="footer-placement">@UiText.Get("PDFAltbilgisininGosterimi")</label><select asp-for="Form.FooterPlacement" id="footer-placement"><option value="AllPages">@UiText.Get("TumSayfalar")</option><option value="LastPage">@UiText.Get("YalnizcaSonSayfa")</option></select>
                </fieldset>
                <p class="muted">@UiText.Get("SonSayfaSecilseDeTumSayfalardaAltbilgi")</p>
                <label for="watermark">@UiText.Get("Filigran")</label><input asp-for="Form.Watermark" id="watermark" maxlength="100" readonly="@(!Model.Projection.WatermarkEditable)" dir="auto" />
                @if (!Model.Projection.WatermarkEditable) { <p class="notice">@UiText.Get("BilinmeyenFiligranAyarlariDegistirilmedenKorunur")</p> }
                <details class="page-layout-fields"><summary>@UiText.Get("SayfaAyarlari")</summary>
                <fieldset disabled="@(!Model.Projection.LayoutEditable)">
                    <div class="two-fields"><div><label asp-for="Form.PageSize">@UiText.Get("KagitBoyutu")</label><select asp-for="Form.PageSize"><option>A4</option><option>A5</option><option>Letter</option><option>Legal</option></select></div>
                    <div><label asp-for="Form.Orientation">@UiText.Get("SayfaYonu")</label><select asp-for="Form.Orientation"><option value="Portrait">@UiText.Get("Dikey")</option><option value="Landscape">@UiText.Get("Yatay")</option></select></div></div>
                    <div class="two-fields"><div><label asp-for="Form.MarginTop">@UiText.Get("UstKenarBosluguMm")</label><input asp-for="Form.MarginTop" type="number" min="5" max="50" step="0.5" /></div><div><label asp-for="Form.MarginRight">@UiText.Get("SagKenarBoslugu")</label><input asp-for="Form.MarginRight" type="number" min="5" max="50" step="0.5" /></div>
                    <div><label asp-for="Form.MarginBottom">@UiText.Get("AltKenarBoslugu")</label><input asp-for="Form.MarginBottom" type="number" min="5" max="50" step="0.5" /></div><div><label asp-for="Form.MarginLeft">@UiText.Get("SolKenarBoslugu")</label><input asp-for="Form.MarginLeft" type="number" min="5" max="50" step="0.5" /></div></div>
                </fieldset>
                @if (!Model.Projection.LayoutEditable) { <p class="notice">@UiText.Get("BilinmeyenSayfaDuzeniAynenKorunur")</p> }
                </details>
                <h3>@UiText.Get("UstbilgiGorseli")</h3>
                <fieldset disabled="@(!Model.Projection.HeaderEditable)" class="subscription-lock">
                    <div class="two-fields"><div><label for="image-layout">@UiText.Get("UstbilgiGorselDuzeni")</label><select asp-for="Form.ImageLayout" id="image-layout"><option value="">@UiText.Get("MevcutAyarlariKoru")</option><option value="logo">@UiText.Get("LogoSinirliBoyut")</option><option value="banner">@UiText.Get("YazdirmaAlaniniKaplayanAfis")</option></select></div>
                    <div><label for="image-alignment">@UiText.Get("UstbilgiGorselHizalamasi")</label><select asp-for="Form.ImageAlignment" id="image-alignment"><option value="">@UiText.Get("MevcutAyarlariKoru")</option><option value="left">@UiText.Get("Sol")</option><option value="center">@UiText.Get("Orta")</option><option value="right">@UiText.Get("Sag")</option></select></div></div>
                </fieldset>
                <p class="muted">@UiText.Get("BuIkiSecenekYeniSurumunTumUstbilgi")</p>
                <div class="template-images">@foreach (var imageId in Model.Projection.Images.Take(10)) { <img src="@Url.Action("Asset", "Workspace", new { tenantId = Model.Tenant.Id, templateId = Model.Selected!.Id, assetId = imageId })" alt="@UiText.Get("MevcutUstbilgiGorseli")" /> }</div>
                @if (Model.Form.PendingAssetId is { } pending) { <p class="notice">@UiText.Get("AsagidakiGorselYuklendiAncakKaydinTamamlandigiDogrulanamadi")</p><img class="template-logo-preview" src="@Url.Action("Asset", "Workspace", new { tenantId = Model.Tenant.Id, templateId = Model.Form.TemplateId, assetId = pending })" alt="@UiText.Get("KaydedilmeyiBekleyenGorsel")" /> }
                <label for="template-logo">@UiText.Get("PNGJPEGGorselSecinEnFazla5")</label><input id="template-logo" name="logo" type="file" accept="image/png,image/jpeg" disabled="@(!Model.Projection.CanAppendLogo)" />
                <img id="template-logo-preview" class="template-logo-preview" alt="@UiText.Get("SecilenGorselinOnizlemesiHenuzKaydedilmedi")" hidden />
                <label asp-for="Form.LogoMode">@UiText.Get("SecilenGorselinEklenmeSekli")</label><select asp-for="Form.LogoMode"><option value="Add">@UiText.Get("MevcutGorselleriKoruyarakEkle")</option>@if (Model.Projection.HeaderEditable) { <option value="Replace">@UiText.Get("TumMevcutUstbilgiGorselleriniDegistir")</option> }</select>
                <p class="muted">@UiText.Get("KaydiBekleyenYuklenmisBirGorselYoksaDosya")</p>
                <button type="submit" id="template-save">@(Model.Selected is null ? UiText.Get("SablonOlustur") : UiText.Get("YeniSurumuKaydet"))</button>
            </fieldset>
        </form>
        <p class="muted">@UiText.Get("OncekiSurumlerVeBelgelereSabitlenenSablonlarDegismez")</p>
        @if (Model.Selected is not null) { <details><summary>@UiText.Get("SecilenSurumunOzgunYapisiSaltOkunur")</summary><pre class="template-json" dir="ltr">@Model.Selected.Revision.EditorContentJson</pre><pre class="template-json" dir="ltr">@Model.Selected.Revision.HeaderContentJson</pre><pre class="template-json" dir="ltr">@Model.Selected.Revision.FooterContentJson</pre></details> }
    </section>
    <section class="card" id="template-live-preview" data-tenant-id="@Model.Tenant.Id" data-template-id="@Model.Form.TemplateId"
        data-content-format="@(Model.Selected?.Revision.ContentDescriptor.DisplayFormat ?? ETranslate.Contracts.Documents.DocumentContentDescriptor.RichFormat)"
        data-content-schema-version="@(Model.Selected?.Revision.ContentDescriptor.DisplaySchemaVersion ?? 1)"
        data-template-content-format="@(Model.Selected?.Revision.ContentDescriptor.DisplayFormat ?? ETranslate.Contracts.Documents.DocumentContentDescriptor.RichFormat)"
        data-template-content-schema-version="@(Model.Selected?.Revision.ContentDescriptor.DisplaySchemaVersion ?? 1)"
        data-header-editable="@Model.Projection.HeaderEditable.ToString().ToLowerInvariant()" data-footer-editable="@Model.Projection.FooterEditable.ToString().ToLowerInvariant()"
        data-body-editable="@Model.Projection.BodyEditable.ToString().ToLowerInvariant()" data-watermark-editable="@Model.Projection.WatermarkEditable.ToString().ToLowerInvariant()"
        data-layout-editable="@Model.Projection.LayoutEditable.ToString().ToLowerInvariant()" data-can-save="@Model.CanSave.ToString().ToLowerInvariant()">
        <h2>@UiText.Get("CanliSablonOnizlemesi")</h2><p id="template-preview-size" class="muted"></p>
        <p class="notice">@UiText.Get("BuOnizlemeKayitYapmazVeTestPDF")</p>
        <label for="preview-page-role">@UiText.Get("OrnekOnizlemeSayfasi")</label><select id="preview-page-role"><option value="Last">@UiText.Get("SonSayfaVeyaTekSayfalikBelge")</option><option value="Earlier">@UiText.Get("SonSayfadanOncekiBirSayfa")</option></select>
        <p id="preview-notice" role="status"></p>
        <div class="template-preview-viewport"><div class="paper template-preview-paper" id="template-preview-paper" dir="ltr"><header class="paper-header" id="preview-header"></header><div class="paper-body" id="preview-body"></div><footer class="paper-footer" id="preview-footer"></footer><div class="watermark" id="preview-watermark"></div></div></div>
        <textarea id="template-header" hidden>@Model.Selected?.Revision.HeaderContentJson</textarea><textarea id="template-footer" hidden>@Model.Selected?.Revision.FooterContentJson</textarea>
        <textarea id="document-json" hidden>@(Model.Selected?.Revision.EditorContentJson ?? ETranslate.Web.Models.DocumentText.Empty)</textarea><textarea id="template-watermark" hidden>@Model.Selected?.Revision.WatermarkJson</textarea>
        <textarea id="template-layout" hidden>@Model.Selected?.Revision.PageLayoutJson</textarea>
    </section>
}
@section Scripts { <script type="module" src="~/js/generated/template-preview.js" asp-append-version="true"></script> }
